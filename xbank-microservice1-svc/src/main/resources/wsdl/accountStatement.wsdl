<wsdl:definitions
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
	xmlns:sch="http://xbank.com/producing-web-service"
	xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:tns="http://xbank.io/producing-web-service"
	targetNamespace="http://xbank.io/producing-web-service">
	<wsdl:types>
		<xs:schema
			xmlns:tns="http://xbank.com/producing-web-service"
			xmlns:xs="http://www.w3.org/2001/XMLSchema"
			elementFormDefault="qualified"
			targetNamespace="http://xbank.com/producing-web-service">
			<xs:element name="getAccountBalanceRequest">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="accountNo" type="xs:string" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="getAccountBalanceResponse">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="balance" type="tns:accountStatement" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:complexType name="accountStatement">
				<xs:sequence>
					<xs:element name="accountNo" type="xs:string" />
					<xs:element name="balance" type="xs:string" />
					<xs:element name="user" type="tns:user" />
					<xs:element name="currency" type="xs:string" />
					<xs:element maxOccurs="unbounded" minOccurs="0"
						name="transactions" type="tns:transactions" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="user">
				<xs:sequence>
					<xs:element name="userId" type="xs:string" />
					<xs:element name="firstName" type="xs:string" />
					<xs:element name="lastName" type="xs:string" />
					<xs:element name="phoneNo" type="xs:string" />
					<xs:element name="address" type="xs:string" />
					<xs:element name="gender" type="xs:string" />
					<xs:element name="emailAddress" type="xs:string" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="transactions">
				<xs:sequence>
					<xs:element name="date" type="xs:string" />
					<xs:element name="transactiontype" type="xs:string" />
					<xs:element name="amount" type="xs:int" />
				</xs:sequence>
			</xs:complexType>
		</xs:schema>
	</wsdl:types>
	<wsdl:message name="getAccountBalanceResponse">
		<wsdl:part element="sch:getAccountBalanceResponse"
			name="getAccountBalanceResponse">
		</wsdl:part>
	</wsdl:message>
	<wsdl:message name="getAccountBalanceRequest">
		<wsdl:part element="sch:getAccountBalanceRequest"
			name="getAccountBalanceRequest">
		</wsdl:part>
	</wsdl:message>
	<wsdl:portType name="accountStatementPort">
		<wsdl:operation name="getAccountBalance">
			<wsdl:input message="tns:getAccountBalanceRequest"
				name="getAccountBalanceRequest">
			</wsdl:input>
			<wsdl:output message="tns:getAccountBalanceResponse"
				name="getAccountBalanceResponse">
			</wsdl:output>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="accountStatementPortSoap11"
		type="tns:accountStatementPort">
		<soap:binding style="document"
			transport="http://schemas.xmlsoap.org/soap/http" />
		<wsdl:operation name="getAccountBalance">
			<soap:operation soapAction="" />
			<wsdl:input name="getAccountBalanceRequest">
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output name="getAccountBalanceResponse">
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="accountStatementPortService">
		<wsdl:port binding="tns:accountStatementPortSoap11"
			name="accountStatementPortSoap11">
			<soap:address location="http://localhost:3011/ws" />
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>